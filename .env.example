# Example environment configuration
# Copy this file to .env and adjust the values for your environment.
# Do NOT check real credentials into version control.
# TODO(agent): Keep this file aligned with docs/ENVIRONMENT.md whenever new settings land.
# TODO(agent): Revisit Postgres defaults whenever docker-compose credentials change.

# Database connectivity (mirrors docker-compose defaults; replace before deploying anywhere public)
# DATABASE_URL=postgres://mediator:mediator@127.0.0.1:5432/mediator
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=mediator
# PGPASSWORD=mediator
#
# Keep secrets out of version control—prefer a local .env override or your secrets manager for production credentials.
# Legacy SQLite fallback (used when DATABASE_URL is unset).
# DB_PATH=./data/mediator.sqlite

# Runtime environment
# NODE_ENV=development

# Service ports
# HTTP_PORT=8080
# HTTPS_PORT=8443

# TLS and public origin settings
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# PUBLIC_HOSTNAME=localhost
# PUBLIC_PROTOCOL=http
# PUBLIC_PORT=8080
# PUBLIC_ORIGIN=http://localhost:8080

# Base URLs for QR code and UI links
# BASE_QR_URL=http://localhost:8080/qr
# BASE_UI_URL=http://localhost:8080/ui

# File intake and archive locations
# INBOX_DIR=./data/inbox
# ARCHIVE_DIR=./data/archive

# Media storage configuration
# TODO(media-root-contract): Keep only root-level media mount configuration documented here.
# MEDIA_STORAGE_MODE=local
# Fixed local media path is dist/media.
# Set MEDIA_ROOT_DIR only when MEDIA_STORAGE_MODE=webdav; service derives
# <root>/shopbilder and <root>/shopbilder-import automatically.
# MEDIA_ROOT_DIR=/app/dist/backend/host-media

# Alternative document directories (optional)
# Path to a JSON file configuring additional filesystem/WebDAV mounts linked to per-item identifiers.
# identifierType: 'ean' (product-level) | 'serialNumber' (per-unit) | 'macAddress' (per-unit) | 'artikelNummer' (catalog-level)
# normalize:      'uppercase' | 'lowercase' | 'strip-colons' (optional)
# writable:       true  — allows uploading new files via the UI (default: false)
# deletable:      true  — allows deleting individual files via the UI (default: false)
# See docs/ENVIRONMENT.md for full schema, identifier scope table, and API endpoint details.
# ALT_DOC_DIRS_FILE=/etc/mediator/alt-doc-dirs.json

# Admin page password protection (optional)
# If set, all /api/admin/* requests must include Authorization: Bearer <value>
# ADMIN_SECRET=

# Authentik (user management / SSO) — consumed by docker-compose.yml only (the backend does
# not read these yet; forward-auth enforcement is a follow-up). Required to start the
# authentik-* services. See docs/setup.md "Authentik (user management)".
# Pin to the current stable release: https://goauthentik.io/docker-compose.yml
# AUTHENTIK_TAG=2024.12.3
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# Dedicated Postgres for Authentik (NOT the mediator DB). User/DB default to "authentik".
# AUTHENTIK_PG_USER=authentik
# AUTHENTIK_PG_DB=authentik
# AUTHENTIK_PG_PASSWORD=change-me
# Django secret key — generate with: openssl rand -base64 60
# AUTHENTIK_SECRET_KEY=
# Host port for the Authentik admin/login UI (http://<host>:<port>/if/admin/).
# AUTHENTIK_PORT=9000
# First-boot bootstrap of the initial akadmin account (ignored once the account exists).
# AUTHENTIK_BOOTSTRAP_PASSWORD=
# AUTHENTIK_BOOTSTRAP_EMAIL=
# AUTHENTIK_BOOTSTRAP_TOKEN=

# Printing configuration
# When using the bundled Docker CUPS service (docker-compose.yml), the queue names and
# CUPS_HOST are set in compose directly — you do not need to set them here.
# Use these overrides only when connecting to a remote CUPS server instead.
#
# CUPS_HOST: hostname:port of the CUPS service. Leave unset to use the shared Unix socket.
# CUPS_HOST=cups:631
#
# PRINTER_SERVER: legacy per-job -h flag for lp/lpstat. Leave unset when using CUPS_HOST.
# PRINTER_SERVER=
#
# Queue names per label type. Overridable at runtime via Admin → Drucker-Einstellungen.
# PRINTER_QUEUE=QL800_box
# PRINTER_QUEUE_BOX=QL800_box
# PRINTER_QUEUE_ITEM=QL800_item
# PRINTER_QUEUE_ITEM_SMALL=QL800_item_small
# PRINTER_QUEUE_SHELF=QL800_shelf
# PRINTER_QUEUE_MARKETING=QL800_marketing
# LP_COMMAND=lp
# LPSTAT_COMMAND=lpstat
# PRINT_TIMEOUT_MS=15000
# PRINT_PREVIEW_DIR=/app/dist/frontend/public/prints
# PRINT_RENDERER=chromium
# PRINT_RENDER_TIMEOUT_MS=10000

# Event log filtering (comma-separated allow lists)
# EVENT_LOG_LEVELS=Information,Warning,Error
# EVENT_LOG_TOPICS=import,item,box

# Langtext export format override for the ERP export boundary only (json, markdown, html).
# Backup exports ALWAYS serialize Langtext as JSON regardless of this value, so a backup stays
# losslessly restorable through the CSV importer. Default when unset: html for ERP.
# LANGTEXT_EXPORT_FORMAT=html

# Importer settings
# IMPORTER_FORCE_ZERO_STOCK=false
# ERP_SYNC_ENABLED=true
# Only approved items are exported/synced to the ERP (default true). Set false only for controlled
# backfills where exporting unreviewed items is acceptable.
# ERP_SYNC_REQUIRE_APPROVAL=true
# Nightly automatic sync: syncs only refs that have been manually synced before (opt-in via LastSyncedAt)
# ERP_NIGHTLY_SYNC_ENABLED=false
# ERP_NIGHTLY_SYNC_HOUR=2
# ERP_IMPORT_INCLUDE_MEDIA=false
# Required for /api/sync/erp — the kivitendo import endpoint and login. No longer hardcoded in
# backend/scripts/erp-sync.sh; when any of the three is missing the sync fails with 503 credentials_missing.
# ERP_IMPORT_URL=https://your-erp.example/kivitendo-erp/controller.pl
# ERP_IMPORT_USERNAME=
# ERP_IMPORT_PASSWORD=
# Optional WebDAV endpoint for the media-mirror stage (reuses the username/password above); skips when unset.
# ERP_WEBDAV_SHOPBILDER_URL=
# ERP_IMPORT_FORM_FIELD=file
# ERP_IMPORT_FORM_SEPARATOR=comma
# ERP_IMPORT_FORM_CHARSET=UTF-8
# ERP_IMPORT_FORM_DEFAULT_BOOKING_GROUP=453
# ERP_IMPORT_FORM_DEFAULT_UNIT=Stck
# ERP_IMPORT_FORM_PART_CLASSIFICATION=2
# ERP_IMPORT_FORM_DATE_FORMAT=dd.mm.yyyy
# ERP_IMPORT_FORM_FULL_PREVIEW=false
# ERP_IMPORT_PROFILE_ID=
# ERP_IMPORT_TMP_PROFILE_ID=
# ERP_IMPORT_REQUEST_CONTRACT=browser-parity
# ERP_IMPORT_BROWSER_PARITY_MAPPINGS=
# ERP_IMPORT_AUTH_FIELD_PREFIX={AUTH}
# ERP_IMPORT_TIMEOUT_MS=30000
# ERP_IMPORT_POLL_INTERVAL_MS=1500
# ERP_IMPORT_POLL_TIMEOUT_MS=20000
# ERP_IMPORT_POLLING_ENABLED=true
# ERP_IMPORT_CLIENT_ID=

# In-process agentic orchestrator configuration
# Choose a model provider and supply the matching connection details.
AGENTIC_MODEL_PROVIDER=ollama
# Legacy MODEL_PROVIDER/OLLAMA_*/OPENAI_* names remain supported at runtime for backwards compatibility.
# MODEL_PROVIDER=ollama

# Ollama provider defaults (override when pointing at a remote host or container alias).
AGENTIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTIC_OLLAMA_MODEL=qwen3:0.6b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:0.6b

# OpenAI-compatible provider defaults
AGENTIC_OPENAI_API_KEY=
AGENTIC_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTIC_OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Generic model provider overrides
# AGENTIC_MODEL_BASE_URL=
# AGENTIC_MODEL_NAME=
# AGENTIC_MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=
# MODEL_API_KEY=

# Ollama context window (num_ctx, tokens). Ollama defaults to ~2-4k — far below the extraction prompt
# (~6-7k tokens) — so the prompt is silently left-truncated and the model returns an empty completion,
# causing the "json match missing" / EXTRACTION_FAILED loop. Default 16384: the deployed gpt-oss:20b is a
# THINKING model, so the window must hold prompt + reasoning pass (2-4k) + JSON answer. The model supports
# 131072, so raise this if VRAM allows (KV cache grows with num_ctx); lower on a smaller GPU. Ollama only.
# MODEL_NUM_CTX=16384
# Force Ollama responses to valid JSON (format: "json"). Strong guard against empty/prose output, but it
# fights a thinking model's reasoning pass — leave OFF for gpt-oss / any reasoning model. Truthy = 1/true/yes/on.
# MODEL_FORMAT_JSON=

# Model HTTP timeouts (undici fetch). Raise these when a cold/large local model is slow to return its
# first token and runs fail with UND_ERR_HEADERS_TIMEOUT. Milliseconds; 0 disables the timeout.
# Defaults: 600000 (10 min), matching the Ollama keep-alive window. Applied as a global fetch dispatcher.
# MODEL_HTTP_HEADERS_TIMEOUT_MS=600000
# MODEL_HTTP_BODY_TIMEOUT_MS=600000

# Agentic search enrichment and rate limiting
TAVILY_API_KEY=
# SEARCH_RATE_LIMIT_DELAY_MS=250
# SEARCH_MAX_PLANS=3
# SEARCH_MAX_AGENT_QUERIES_PER_REQUEST=1
# SEARCH_WEB_ALLOWED_ENGINES="google,duckduckgo,brave"

# Optional agent identity override
# AGENT_ACTOR_ID=item-flow-service

# Shopware search integration (read-only)
# Populate these values to enable search. Leaving any field blank keeps the integration disabled.
SHOPWARE_ENABLED=false
SHOPWARE_BASE_URL=
SHOPWARE_SALES_CHANNEL_ID=
# SHOPWARE_SALES_CHANNEL=
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
# Optionally supply a pre-generated API token instead of client credentials. Either
# SHOPWARE_ACCESS_TOKEN or SHOPWARE_API_TOKEN is accepted. Leave both blank to rely on client credentials.
SHOPWARE_ACCESS_TOKEN=
# SHOPWARE_API_TOKEN=
# Request timeout in milliseconds for outbound Shopware API calls.
SHOPWARE_REQUEST_TIMEOUT_MS=10000

# Shopware sync queue (currently disabled – do not enable until dispatch is implemented)
SHOPWARE_SYNC_ENABLED=false
# SHOPWARE_QUEUE_ENABLED=false
SHOPWARE_API_BASE_URL=
# SHOPWARE_QUEUE_POLL_INTERVAL_MS=5000

# Frontend runtime flags (injected into the UI build/hosting environment)
# AUTO_PRINT_ITEM_LABEL=false
